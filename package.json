{
  "name": "fenxi-dl",
  "version": "1.0.0",
  "description": "FenxiDL - multi-connection segmented download manager",
  "main": "dist/main/index.js",
  "author": {
    "name": "tech-zerolei",
    "email": "tech-zerolei@users.noreply.github.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:main": "node build/build-main.mjs",
    "build:renderer": "node build/build-renderer.mjs",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:dev": "node build/build-main.mjs --dev && node build/build-renderer.mjs --dev",
    "start": "npm run build && electron .",
    "start:dev": "npm run build:dev && electron .",
    "build:test": "node build/build-test.mjs",
    "build:e2e": "node build/build-e2e.mjs",
    "build:integration": "node build/build-integration.mjs",
    "test:unit": "npm run build:test && node --test dist/test/",
    "test:integration": "npm run build:integration && node dist/test/integration.mjs",
    "test:e2e": "npm run build:e2e && node dist/test/e2e-download.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "verify": "npm run typecheck && npm run build:main && npm run build:renderer && npm run test:unit && npm run test:integration && npm run test:e2e",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64 && node build/patch-appimage.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true
  },
  "build": {
    "appId": "com.fenxidl.downloadmanager",
    "productName": "FenxiDL",
    "copyright": "Copyright © 2026 FenxiDL Project",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "!dist/test/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FenxiDL",
      "uninstallDisplayName": "FenxiDL 下载管理器",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "synopsis": "高速多线程下载管理器",
      "description": "FenxiDL 是一个使用 Electron + TypeScript 构建的高速多线程下载管理器。",
      "maintainer": "tech-zerolei <tech-zerolei@users.noreply.github.com>",
      "executableArgs": []
    },
    "extraResources": [
      {
        "from": "assets/THIRD-PARTY-NOTICES.txt",
        "to": "LICENSE-FenxiDL.txt"
      }
    ],
    "afterPack": "build/after-pack-linux.cjs"
  },
  "homepage": "https://github.com/tech-zerolei/fenxidl"
}
